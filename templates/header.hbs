<!-- Infobars: 1 critical + 2 general. Each bar's text is a dynamic content item, so it can be
     translated and changed without a theme release. A general bar's text may start with a
     <span class="hc-infobar-tag">Flash deal</span> pill and use <strong> (highlight) and <a>.
     global.js handles dismissing. -->
{{#if settings.show_warning_infobar_global}}
<div class="hc-infobar hc-infobar--critical" data-infobar="critical" role="alert">
	<svg class="hc-infobar-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<circle cx="12" cy="12" r="11" fill="var(--color-accent-lime)"></circle>
		<path d="M12 7v6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
		<circle cx="12" cy="16.6" r="1.3" fill="currentColor"></circle>
	</svg>
	<span class="hc-infobar-text">{{dc settings.critical_infobar_dc}}</span>
	<button type="button" class="hc-infobar-dismiss" aria-label="Dismiss">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
</div>
{{/if}}
{{#if settings.show_infobar_global}}
<div class="hc-infobar hc-infobar--general hc-infobar--{{settings.general_infobar_1_variant}}" data-infobar="general-1">
	<span class="hc-infobar-text">{{dc settings.general_infobar_1_dc}}</span>
	<button type="button" class="hc-infobar-dismiss" aria-label="Dismiss">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
</div>
{{/if}}
{{#if settings.show_infobar_2_global}}
<div class="hc-infobar hc-infobar--general hc-infobar--{{settings.general_infobar_2_variant}}" data-infobar="general-2">
	<span class="hc-infobar-text">{{dc settings.general_infobar_2_dc}}</span>
	<button type="button" class="hc-infobar-dismiss" aria-label="Dismiss">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
</div>
{{/if}}

<!-- Navbar -->
<header class="hc-header w-full bg-navbar-bg border-b border-brand/12">
	<div class="h-[72px] flex items-center gap-4 px-5 md:px-14">
		<a href="{{page_path 'help_center'}}" class="flex items-center gap-3.5 min-w-0 !no-underline">
			<img src="{{settings.logo}}" alt="{{settings.brand_name}}" class="h-[26px] w-auto block" />
			<span class="w-px h-[22px] bg-brand/18 block"></span>
			<span class="text-base font-semibold text-brand tracking-[-0.01em] truncate">{{settings.hc_label}}</span>
		</a>
		<div class="flex-1"></div>
		<nav class="hidden md:flex items-center gap-7">
			<a href="{{page_path 'new_request'}}" class="text-sm text-black">{{t 'submit_a_request'}}</a>
			<a href="{{settings.codashop_link}}" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-brand">
				{{dc 'hc_-_visit_codashop_store'}}
				<i class="ph ph-arrow-right text-sm"></i>
			</a>
			{{#if alternative_locales}}
			<details class="dropdown dropdown-end">
				<summary
					class="list-none flex items-center gap-2 h-[38px] px-3.5 bg-white border border-brand/20 rounded-[10px] text-sm text-black cursor-pointer transition-colors hover:border-brand">
					<i class="ph ph-globe text-xl text-brand"></i>
					<span>{{current_locale.name}}</span>
					<i class="ph ph-caret-down text-[10px]"></i>
				</summary>
				<ul
					class="dropdown-content menu w-56 mt-2 p-2 bg-white border border-brand/14 rounded-xl max-h-[400px] overflow-y-auto flex-nowrap z-50">
					{{#each alternative_locales}}
					<li><a href="{{url}}" dir="{{direction}}" class="text-sm text-black">{{name}}</a></li>
					{{/each}}
				</ul>
			</details>
			{{/if}}
		</nav>
		<button id="hamburger-btn" type="button" aria-label="Menu" aria-controls="mobile-drawer"
			class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1 bg-transparent border-none cursor-pointer">
			<span class="block w-5 h-0.5 rounded bg-brand"></span>
			<span class="block w-5 h-0.5 rounded bg-brand"></span>
			<span class="block w-5 h-0.5 rounded bg-brand"></span>
		</button>
	</div>
	<!-- Menu drawer on mobile -->
	<div id="mobile-drawer" class="hidden md:hidden border-t border-brand/12 px-5 py-4">
		<div class="flex flex-col gap-4">
			<a href="{{page_path 'new_request'}}" class="text-[15px] text-black">{{t 'submit_a_request'}}</a>
			<a href="{{settings.codashop_link}}" target="_blank" rel="noopener" class="flex items-center gap-2 text-[15px] text-brand">
				{{dc 'hc_-_visit_codashop_store'}}
				<i class="ph ph-arrow-right text-sm"></i>
			</a>
			{{#if alternative_locales}}
			<details>
				<summary class="list-none flex items-center gap-2 text-[15px] text-black cursor-pointer">
					<i class="ph ph-globe text-xl text-brand"></i>
					<span>{{current_locale.name}}</span>
					<i class="ph ph-caret-down text-[10px]"></i>
				</summary>
				<ul class="mt-2 pl-7 flex flex-col gap-2">
					{{#each alternative_locales}}
					<li><a href="{{url}}" dir="{{direction}}" class="text-sm text-black">{{name}}</a></li>
					{{/each}}
				</ul>
			</details>
			{{/if}}
		</div>
	</div>
</header>
