<div id="hc-all-topics" class="max-w-[1040px] mx-auto px-5 md:px-14 pt-9 pb-16 md:pb-24">
	<!-- Breadcrumb + compact search -->
	<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-8">
		<nav class="flex items-center gap-2.5 text-[13.5px] text-black/55 min-w-0" aria-label="Breadcrumb">
			<a href="{{page_path 'help_center'}}" class="text-black/55 hover:text-brand shrink-0">{{dc 'hc_-_help_center'}}</a>
			<span aria-hidden="true">/</span>
			<span class="truncate">{{dc 'hc_-_all_topics'}}</span>
		</nav>
		<div class="hc-search hc-search--compact w-full md:w-[300px] flex-none" data-placeholder="{{dc 'hc_-_search_placeholder'}}">
			<i class="ph ph-magnifying-glass hc-search-icon"></i>
			{{search instant=true submit=false}}
		</div>
	</div>

	<h1 class="hc-hero-title mt-7 mb-0 text-[30px] md:text-[36px] leading-[1.1] font-semibold">{{dc 'hc_-_all_topics'}}</h1>
	<p class="mt-3.5 mb-0 max-w-[560px] !text-base leading-[1.6] text-black/60 [text-wrap:pretty]">{{dc 'hc_-_all_topics_intro'}}</p>

	<!-- Custom pages get no Help Center data: global.js fills this from the API using the two templates below -->
	<div id="hc-topics" class="hc-cat-grid flex flex-col gap-12 md:gap-14 mt-10 md:mt-12" data-label="{{dc 'hc_-_n_articles'}}"></div>

	<template id="hc-topic-template">
		<section class="hc-cat">
			<div class="flex items-baseline justify-between gap-6 border-b-[1.5px] border-brand pb-3.5">
				<div class="flex items-center gap-3 min-w-0">
					<span class="hc-cat-badge" aria-hidden="true"></span>
					<h2 class="m-0 !text-[19px] md:!text-[21px] font-semibold tracking-[-0.02em] text-brand">
						<a data-slot="name" class="text-brand"></a>
					</h2>
				</div>
				<a data-slot="count" class="hc-eyebrow flex-none !text-[11px] tracking-[0.1em] !text-brand"></a>
			</div>
			<div data-slot="sections" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-9 mt-[26px]"></div>
		</section>
	</template>

	<template id="hc-topic-section-template">
		<div class="min-w-0">
			<a data-slot="name" class="block text-base font-semibold tracking-[-0.015em] text-brand underline underline-offset-[3px]"></a>
			<div data-slot="count" class="hc-eyebrow !text-[10px] tracking-[0.1em] mt-2"></div>
			<ul data-slot="articles" class="mt-2.5"></ul>
		</div>
	</template>
</div>
