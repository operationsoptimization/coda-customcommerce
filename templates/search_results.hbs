<div id="hc-search-results" class="max-w-[1040px] mx-auto px-5 md:px-14 pt-9 md:pt-11 pb-16 md:pb-24">
	{{#if results}}
	<div class="hc-search hc-search--page" data-placeholder="{{dc 'hc_-_search_placeholder'}}">
		<i class="ph ph-magnifying-glass hc-search-icon"></i>
		{{search instant=true submit=false}}
	</div>

	<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 sm:gap-6 mt-7">
		<!-- global.js fills {count} and {query} from the data attributes -->
		<h1 class="m-0 text-[20px] md:text-[22px] font-semibold tracking-[-0.015em] [text-wrap:pretty]"
			data-label="{{dc 'hc_-_n_results_for_query'}}" data-count="{{results_count}}" data-query="{{query}}">
			{{t 'preview_result_header' query=query}}
		</h1>
		<span class="hc-eyebrow flex-none !text-[11px] tracking-[0.1em]">{{dc 'hc_-_sorted_by_relevance'}}</span>
	</div>

	<!-- Topic chips. Zendesk only provides subfilters once a content type filter is active,
	     so when there are none global.js builds the category chips from the Help Center API.
	     It also points "All topics" at the unfiltered search and reveals the row. -->
	<nav id="hc-search-topics" class="hidden flex-wrap gap-2 mt-[18px]" aria-label="{{dc 'hc_-_all_topics'}}">
		<a id="hc-search-all" href="#" class="hc-chip">{{dc 'hc_-_all_topics'}}</a>
		{{#each subfilters}}
		<a href="{{url}}" class="hc-chip" {{#if selected}}aria-current="true"{{/if}}>{{name}}</a>
		{{/each}}
	</nav>

	<ul id="results" class="mt-7 border-t border-brand/12 scroll-mt-6">
		{{#each results}}
		<li>
			<a href="{{url}}" class="hc-result">
				<span class="hc-result-path hc-eyebrow tracking-[0.1em]">
					{{#each path_steps}}<span>{{name}}</span>{{/each}}
				</span>
				<span class="hc-result-title">{{title}}</span>
				<span class="hc-result-text">{{text}}</span>
			</a>
		</li>
		{{/each}}
	</ul>
	{{pagination}}

	<div class="mt-10 bg-lavender rounded-3xl px-6 py-7 md:px-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5 md:gap-8">
		<div class="min-w-0">
			<h2 class="m-0 !text-[19px] font-semibold text-brand">{{dc 'hc_-_not_finding_an_answer'}}</h2>
			<p class="mt-2 mb-0 !text-[14.5px] leading-normal text-brand/80">{{dc 'hc_-_not_finding_an_answer_text'}}</p>
		</div>
		<a href="{{page_path 'new_request'}}" class="hc-btn hc-btn--dark !h-[46px] !px-[22px] !text-[15px] flex-none max-md:w-full">
			{{dc 'hc_standard_-_submit_a_request_button'}}
		</a>
	</div>

	{{else}}
	<!-- No results -->
	<div class="hc-search hc-search--page hc-search--page-button" data-placeholder="{{dc 'hc_-_search_placeholder'}}">
		<i class="ph ph-magnifying-glass hc-search-icon"></i>
		{{search instant=true submit=true}}
	</div>

	<div class="max-w-[620px] mt-10 md:mt-12">
		<div class="hc-eyebrow !text-[11px]">{{dc 'hc_-_no_results'}}</div>
		<!-- global.js fills {query}; data-count is 0 here -->
		<h1 class="hc-hero-title mt-3.5 mb-0 text-[26px] md:text-[32px] leading-[1.14] font-semibold"
			data-label="{{dc 'hc_-_no_results_for_query'}}" data-count="{{results_count}}" data-query="{{query}}">
			{{t 'no_results_unified'}}
		</h1>
		<p class="mt-4 mb-0 !text-base leading-[1.6] text-black/60 [text-wrap:pretty]">{{dc 'hc_-_no_results_tips'}}</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_340px] gap-10 md:gap-16 mt-10 md:mt-12 items-start">
		<div class="min-w-0">
			<a href="{{page_path 'help_center'}}/p/all_topics" class="hc-see-all">{{dc 'hc_-_browse_all_topics'}}</a>
		</div>

		<div class="bg-lavender rounded-3xl p-6 md:p-7">
			<h2 class="m-0 !text-[19px] font-semibold text-brand [text-wrap:pretty]">{{dc 'hc_-_still_nothing'}}</h2>
			<p class="mt-2.5 mb-0 !text-[14.5px] leading-[1.55] text-brand/80">{{dc 'hc_-_still_nothing_text'}}</p>
			<a href="{{page_path 'new_request'}}" class="hc-btn hc-btn--dark w-full !h-12 !text-[15px] mt-5">
				{{dc 'hc_standard_-_submit_a_request_button'}}
			</a>
			{{#isnt settings.homepage_variant 'search_only'}}
			<button id="ask-codee" type="button" class="hc-btn hc-btn--outline w-full !h-12 !text-[15px] mt-2.5">
				{{dc 'hc_-_chat_with_codee'}}
			</button>
			{{/isnt}}
		</div>
	</div>
	{{/if}}
</div>

{{#unless results}}
{{#isnt settings.homepage_variant 'search_only'}}
<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="{{settings.druid_lang}}" type="text/javascript">
	document.addEventListener("DOMContentLoaded", function (event) {
		const botId = "{{settings.druid_bot_id}}".trim();
		const botQueryParams = "{{settings.druid_query_params}}".split("amp;").join('');

		DruidWebchat_v2.init({
			botId: botId,
			baseUrl: "https://druidapi.au.druidplatform.com",
			queryParams: botQueryParams,
			UI: {
				containerElement: document.getElementById('ask-codee')
			}
		});
	});
</script>
{{/isnt}}
{{/unless}}
