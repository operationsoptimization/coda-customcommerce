<div id="hc-article" class="max-w-[1040px] mx-auto px-5 md:px-14 pt-9 pb-16 md:pb-24">
	<!-- Breadcrumb + compact search -->
	<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-8">
		<nav class="hc-breadcrumbs min-w-0" aria-label="Breadcrumb">
			{{breadcrumbs}}
		</nav>
		<div class="hc-search hc-search--compact w-full md:w-[300px] flex-none" data-placeholder="{{dc 'hc_-_search_placeholder'}}">
			<i class="ph ph-magnifying-glass hc-search-icon"></i>
			{{search instant=true submit=false}}
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_260px] gap-12 md:gap-16 mt-7">
		<article id="main-content" class="min-w-0 max-w-[680px]">
			<h1 class="hc-hero-title m-0 text-[28px] md:text-[34px] leading-[1.15] font-semibold">
				{{article.title}}
				{{#if article.internal}}
				<i class="ph ph-lock-simple text-[0.7em] align-middle ml-1" title="{{t 'internal'}}"></i>
				{{/if}}
			</h1>
			<!-- global.js swaps in the dynamic content label with the date and read time -->
			<div id="hc-article-meta" class="hc-eyebrow mt-4" data-label="{{dc 'hc_-_article_meta'}}">
				{{date article.edited_at format='medium'}}
			</div>

			<div class="article-body mt-7">{{article.body}}</div>

			{{#if attachments}}
			<ul class="attachments mt-8">
				{{#each attachments}}
				<li class="attachment-item">
					<i class="ph ph-paperclip attachment-icon"></i>
					<a href="{{url}}" target="_blank" rel="noopener">{{name}}</a>
					<span class="text-[13px] text-black/50 ml-2">{{size}}</span>
				</li>
				{{/each}}
			</ul>
			{{/if}}

			{{#with article}}
			<div class="hc-votes mt-9 pt-6 border-t border-brand/12 flex flex-wrap items-center gap-4">
				<span id="article-votes-label" class="text-[15px] text-black/70">{{t 'was_this_article_helpful'}}</span>
				<div class="flex gap-2.5" role="group" aria-labelledby="article-votes-label">
					{{vote 'up' role='radio' class='hc-vote' selected_class='hc-vote--selected'}}
					{{vote 'down' role='radio' class='hc-vote' selected_class='hc-vote--selected'}}
				</div>
				{{vote 'label' class='text-[11px] font-semibold text-black/40'}}
			</div>
			{{/with}}
		</article>

		<aside class="min-w-0 md:self-start md:sticky md:top-24">
			<div class="hc-related">{{related_articles}}</div>

			{{#isnt settings.homepage_variant 'search_only'}}
			<div class="mt-7 bg-lavender rounded-[20px] p-[22px]">
				<h3 class="m-0 !text-base font-semibold text-brand">{{dc 'hc_-_faster_with_codee'}}</h3>
				<p class="mt-2 mb-0 !text-[13.5px] leading-normal text-brand/80">{{dc 'hc_-_codee_card_text'}}</p>
				<button id="ask-codee" type="button" class="hc-btn hc-btn--dark hc-btn--sm mt-4">{{dc 'hc_-_chat_with_codee'}}</button>
			</div>
			{{/isnt}}
		</aside>
	</div>
</div>

{{#isnt settings.homepage_variant 'search_only'}}
<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="{{settings.druid_lang}}" type="text/javascript">
	document.addEventListener("DOMContentLoaded", function (event) {
		const botId = "{{settings.druid_bot_id}}".trim();
		const botQueryParams = "{{settings.druid_query_params}}".split("amp;").join('');

		DruidWebchat_v2.init({
			botId: botId,
			baseUrl: "https://druidapi.au.druidplatform.com",
			queryParams: botQueryParams,
			UI: {
				containerElement: document.getElementById('ask-codee')
			}
		});
	});
</script>
{{/isnt}}
