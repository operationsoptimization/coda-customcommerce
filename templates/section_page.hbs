<div id="hc-section" class="max-w-[1040px] mx-auto px-5 md:px-14 pt-9 pb-16 md:pb-[88px]">
	<!-- Breadcrumb + compact search -->
	<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-8">
		<nav class="hc-breadcrumbs min-w-0" aria-label="Breadcrumb">
			{{breadcrumbs}}
		</nav>
		<div class="hc-search hc-search--compact w-full md:w-[300px] flex-none" data-placeholder="{{dc 'hc_-_search_placeholder'}}">
			<i class="ph ph-magnifying-glass hc-search-icon"></i>
			{{search instant=true submit=false}}
		</div>
	</div>

	<h1 class="hc-hero-title mt-7 mb-0 text-[30px] md:text-[36px] leading-[1.1] font-semibold">{{section.name}}</h1>

	<div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_280px] gap-12 md:gap-16 mt-8">
		<div class="min-w-0">
			{{#if section.description}}
			<p class="m-0 max-w-[560px] !text-base leading-[1.6] text-black/60 [text-wrap:pretty]">{{section.description}}</p>
			{{/if}}
			<div class="hc-eyebrow mt-[22px]" data-count="{{section.article_count}}"
				data-label="{{dc 'hc_-_n_articles_in_section'}}">{{section.article_count}}</div>

			{{#if section.sections}}
			<ul class="mt-2.5 border-t border-brand/12">
				{{#each section.sections}}
				<li>
					<a href="{{url}}" class="hc-row hc-row--lg !py-[18px]">
						<span class="flex items-center gap-3"><i class="ph ph-folder text-brand"></i>{{name}}</span>
						<i class="ph ph-arrow-right"></i>
					</a>
				</li>
				{{/each}}
			</ul>
			{{/if}}

			{{#if section.articles}}
			<ul class="{{#unless section.sections}}mt-2.5 border-t border-brand/12{{/unless}}">
				{{#each section.articles}}
				<li>
					<a href="{{url}}" class="hc-row hc-row--lg !py-[18px]">
						<span>{{title}}</span>
						<i class="ph ph-arrow-right"></i>
					</a>
				</li>
				{{/each}}
			</ul>
			{{pagination "section.articles"}}
			{{/if}}

			{{#unless section.sections}}{{#unless section.articles}}
			<p class="mt-6 !text-[15px] text-black/55">{{dc 'hc_-_no_articles_in_section'}}</p>
			{{/unless}}{{/unless}}
		</div>

		<aside class="min-w-0">
			<!-- Filled by global.js: sibling sections of this one, with counts -->
			<div id="hc-sibling-sections" class="hidden" data-section-id="{{section.id}}"
				data-label="{{dc 'hc_-_sections_in_category'}}" data-back-label="{{dc 'hc_-_back_to_category'}}">
				<div class="hc-eyebrow text-black/50"></div>
				<ul class="hc-topic-list mt-3"></ul>
				<a class="hc-see-all !mt-[18px]"></a>
			</div>

			{{#isnt settings.homepage_variant 'search_only'}}
			<div class="mt-7 bg-lavender rounded-[20px] p-[22px]">
				<h3 class="m-0 !text-base font-semibold text-brand">{{dc 'hc_-_faster_with_codee'}}</h3>
				<p class="mt-2 mb-0 !text-[13.5px] leading-normal text-brand/80">{{dc 'hc_-_codee_card_text'}}</p>
				<button id="ask-codee" type="button" class="hc-btn hc-btn--dark hc-btn--sm mt-4">{{dc 'hc_-_chat_with_codee'}}</button>
			</div>
			{{/isnt}}
		</aside>
	</div>
</div>

{{#isnt settings.homepage_variant 'search_only'}}
<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="{{settings.druid_lang}}" type="text/javascript">
	document.addEventListener("DOMContentLoaded", function (event) {
		const botId = "{{settings.druid_bot_id}}".trim();
		const botQueryParams = "{{settings.druid_query_params}}".split("amp;").join('');

		DruidWebchat_v2.init({
			botId: botId,
			baseUrl: "https://druidapi.au.druidplatform.com",
			queryParams: botQueryParams,
			UI: {
				containerElement: document.getElementById('ask-codee')
			}
		});
	});
</script>
{{/isnt}}
