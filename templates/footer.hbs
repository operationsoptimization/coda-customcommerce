<footer id="hc-footer" class="border-t border-brand/12 px-5 md:px-14 pt-8 pb-11">
	<div class="max-w-[1040px] mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6 md:gap-8">
		<div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-7">
			<a href="{{page_path 'help_center'}}" class="block w-max">
				<img src="{{settings.logo}}" alt="{{settings.brand_name}}" class="h-5 w-auto block opacity-75" />
			</a>
			<nav class="flex flex-wrap items-center gap-x-7 gap-y-2">
				<a href="{{page_path 'help_center'}}" class="hc-footer-link">{{dc 'hc_-_all_topics'}}</a>
				{{#if settings.show_pp_link}}
				<a href="{{settings.privacy_link}}" class="hc-footer-link">{{dc 'hc_-_privacy_policy'}}</a>
				{{/if}}
				{{#if settings.show_terms_link}}
				<a href="{{settings.terms_link}}" class="hc-footer-link">{{dc 'hc_-_terms_and_conditions'}}</a>
				{{/if}}
				<a href="{{settings.webstore_link}}" target="_blank" rel="noopener" class="hc-footer-link">{{dc 'hc_-_codashop_store'}}</a>
			</nav>
		</div>
		<span class="text-[10.5px] font-semibold tracking-[0.1em] uppercase text-black/45">{{settings.hc_label}}</span>
	</div>
</footer>
