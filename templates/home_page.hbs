<div class="gtranslate_wrapper"></div>
<!-- Hero Section -->
<section id="cc-hero-section" class="hero min-h-[30dvh] sm:min-h-[40dvh]" style="background-color: #242424;">
	<div class="hero-overlay"></div>
	<div class="hero-content w-full max-w-3xl text-neutral-content text-center">
		<div class="w-full">
			<h1 class="mb-5 text-banner-text font-bold">
				How can we help?
			</h1>
			{{search
			instant=true
			class="input max-md:w-full md:w-2/3 lg:w-full focus-within:outline-sky-500 !text-main-text rounded-lg h-12 py-1"
			}}
		</div>
	</div>
</section>

<section id="self-service-articles-section" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="flex flex-col items-center">
		<h2 class="!text-3xl text-main-text text-center font-bold">Self Service Support Center</h2>
		<p class="text-center text-main-text mt-2">Get instant help by exploring our well-organized knowledge base</p>
		<div class="w-full mt-8 space-y-8">
			{{#each categories}}
			{{#isnt name "Master Duel"}}
			{{#isnt name "Suikoden STAR LEAP"}}
			{{#if sections}}
			<div class="bg-accordion-bg border border-gray-200 shadow-sm rounded-lg p-6">
				<div class="flex flex-row justify-between items-center mb-6">
					<div>
						<h4 class="text-lg font-semibold text-accordion-text">
							<a href="{{url}}" class="flex items-center gap-2 hover:text-brand transition-colors group notranslate">
								{{name}}
								<i
									class="ph ph-arrow-right text-sm opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
							</a>
						</h4>
						{{#if description}}
						<p class="text-accordion-text font-light mt-1">
							{{description}}
						</p>
						{{/if}}
					</div>
					{{#if (compare sections.length ">" 4)}}
					<a href="{{url}}"
						class="btn btn-sm bg-transparent border border-cta text-cta hover:bg-cta hover:text-cta-text transition-colors rounded-lg shadow-sm">
						View More
						<i class="ph ph-arrow-right text-xs"></i>
					</a>
					{{/if}}
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{{#each sections}}
					{{#if (compare @index "<" 4)}} <a href="{{url}}"
						class="btn btn-md h-[60px] flex items-center justify-between border-2 border-cta bg-white text-cta hover:bg-cta hover:text-white transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm p-4">
						<span class="text-left">{{name}}</span>
						<i class="ph ph-arrow-right flex-shrink-0"></i>
						</a>
						{{/if}}
						{{/each}}
				</div>
			</div>
			{{/if}}
			{{/isnt}}
			{{/isnt}}
			{{/each}}
		</div>
	</div>
</section>

<section id="self-service-articles-section" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="flex flex-col items-center">
		<div class="p-4 flex items-center justify-center rounded-full bg-brand">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#ffffff" viewBox="0 0 256 256">
				<path
					d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z">
				</path>
			</svg>
		</div>
		<h3 class="text-lg font-semibold text-main-text !mt-4">Need Assistance?</h3>
		<p class="text-main-text text-center mt-2">Can't find what you're looking for? Our support team is here to help.</p>
		<a href="{{page_path 'new_request'}}"
			class="btn bg-brand hover:bg-brand/90 border-none shadow-none text-cta-text mt-4">
			Contact Support
		</a>
	</div>
</section>
